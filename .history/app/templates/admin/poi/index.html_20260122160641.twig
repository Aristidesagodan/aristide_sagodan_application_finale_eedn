{% extends 'admin/layout.html.twig' %}

{% block title %}Liste des POI{% endblock %}

{% block content %}
<h1>POI</h1>
<p><a href="{{ path('admin_poi_new') }}" class="btn btn-success">Créer un nouveau POI</a></p>

{% if pois is empty %}
    <p>Aucun POI disponible.</p>
{% else %}
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Ville</th>
            <th>Catégorie</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for poi in pois %}
        <tr>
            <td>{{ poi.id }}</td>
            <td>{{ poi.name }}</td>
            <td>{{ poi.city.name }}</td>
            <td>{{ poi.category.name }}</td>
            <td>
                <a href="{{ path('admin_poi_edit', {'id': poi.id}) }}">✏️ Edit</a> |
                <a href="{{ path('admin_poi_delete', {'id': poi.id}) }}"
                   onclick="return confirm('Voulez-vous vraiment supprimer ce POI ?');">
                   🗑 Supprimer
                </a>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}
{% endblock %}
