# =====================
# ENVIRONNEMENT
# =====================
APP_ENV=dev
APP_DEBUG=1

# =====================
# MYSQL (SQL - Symfony)
# =====================
DATABASE_URL="mysql://symfony:symfony@database:3306/travel_guide?serverVersion=8.0"

# =====================
# MONGODB (NoSQL - Reviews)
# =====================
# URI complète avec utilisateur root (doit correspondre au docker-compose)
MONGODB_URI="mongodb://root:root@symfony_mongodb:27017"
MONGODB_DB="travel_guide_nosql"
