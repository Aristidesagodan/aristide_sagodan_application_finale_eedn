<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin{% endblock %}</title>

    {# CSS simples directement depuis public/ #}
    <link rel="stylesheet" href="{{ asset('admin.css') }}">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
</head>
<body class="light-mode">

<header>
    <nav>
        <a href="{{ path('admin_dashboard') }}">Dashboard</a> |
        <a href="{{ path('admin_city_index') }}">Villes</a> |
        <a href="{{ path('admin_poi_index') }}">POI</a> |
        <a href="{{ path('admin_poicategory_index') }}">Catégories</a> |
        <a href="{{ path('admin_user_index') }}">Utilisateurs</a>
    </nav>
    <button id="toggleTheme">Toggle Dark/Light</button>
</header>

<main>
    {% block content %}{% endblock %}
</main>

{# JS #}
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="{{ asset('admin.js') }}"></script>
</body>
</html>
