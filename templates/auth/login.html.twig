{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<h1>Connexion</h1>

{% if error %}
<p style="color:red">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
{% endif %}

<form method="post">
    <input type="email" name="_username" value="{{ last_username }}" required placeholder="email">
    <input type="password" name="_password" required placeholder="password">
    <button>Se connecter</button>
</form>
{% endblock %}
