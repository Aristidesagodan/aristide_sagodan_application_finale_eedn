{% extends 'admin/layout.html.twig' %}

{% block title %}Éditer Catégorie{% endblock %}

{% block content %}
<h1>Éditer Catégorie: {{ category.name }}</h1>

{{ form_start(form) }}

<div>
    {{ form_label(form.name) }}
    {{ form_widget(form.name) }}
    {{ form_errors(form.name) }}
</div>

<div>
    {{ form_widget(form.save) }}
</div>

{{ form_end(form) }}

<a href="{{ path('admin_poicategory_index') }}">Retour à la liste</a>
{% endblock %}
