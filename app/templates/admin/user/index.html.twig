{% extends 'admin/layout.html.twig' %}

{% block title %}Liste des Utilisateurs{% endblock %}

{% block content %}
<h1>Utilisateurs</h1>
<a href="{{ path('admin_user_new') }}">Créer un nouvel utilisateur</a>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Nom complet</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
        <tr>
            <td>{{ user.id }}</td>
            <td>{{ user.email }}</td>
            <td>{{ user.email }}</td>
            <td>
                <a href="{{ path('admin_user_edit', {'id': user.id}) }}">Edit</a> |
                <a href="{{ path('admin_user_delete', {'id': user.id}) }}">Supprimer</a>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
