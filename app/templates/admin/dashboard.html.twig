{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block content %}
<h1>Dashboard Admin</h1>

{# ----------------------------- #}
{# Statistiques globales avec graphique #}
{# ----------------------------- #}
<div style="display:flex; gap:20px; margin-bottom:30px;">
    <div style="padding:20px; border:1px solid #ccc; border-radius:8px; text-align:center;">
        <h2>Villes</h2>
        <p style="font-size:24px; font-weight:bold;">{{ totalCities }}</p>
    </div>

    <div style="padding:20px; border:1px solid #ccc; border-radius:8px; text-align:center;">
        <h2>POI</h2>
        <p style="font-size:24px; font-weight:bold;">{{ totalPois }}</p>
    </div>

    <div style="padding:20px; border:1px solid #ccc; border-radius:8px; text-align:center;">
        <h2>Catégories</h2>
        <p style="font-size:24px; font-weight:bold;">{{ totalCategories }}</p>
    </div>

    <div style="padding:20px; border:1px solid #ccc; border-radius:8px; text-align:center;">
        <h2>Utilisateurs</h2>
        <p style="font-size:24px; font-weight:bold;">{{ totalUsers }}</p>
    </div>

    <div style="padding:20px; border:1px solid #ccc; border-radius:8px; text-align:center;">
        <h2>Avis</h2>
        <p style="font-size:24px; font-weight:bold;">{{ totalReviews }}</p>
    </div>
</div>

{# ----------------------------- #}
{# Graphique Chart.js #}
{# ----------------------------- #}
<canvas id="statsChart" style="max-width:600px; margin-bottom:40px;"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('statsChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Villes', 'POI', 'Catégories', 'Utilisateurs', 'Avis'],
            datasets: [{
                label: 'Statistiques globales',
                data: [{{ totalCities }}, {{ totalPois }}, {{ totalCategories }}, {{ totalUsers }}, {{ totalReviews }}],
                backgroundColor: ['#4CAF50', '#2196F3', '#FFC107', '#E91E63', '#9C27B0']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                title: {
                    display: true,
                    text: 'Statistiques globales du site'
                }
            },
            scales: {
                y: { beginAtZero: true, stepSize: 1 }
            }
        }
    });
</script>

{# ----------------------------- #}
{# Dernières Villes #}
{# ----------------------------- #}
<h2>Dernières Villes</h2>
<ul>
    {% for city in cities %}
        <li>
            {{ city.name }} - 
            <a href="{{ path('admin_city_edit', {'id': city.id}) }}">Éditer</a>
        </li>
    {% endfor %}
</ul>

{# ----------------------------- #}
{# Derniers POI #}
{# ----------------------------- #}
<h2>Derniers POI</h2>
<ul>
    {% for poi in pois %}
        <li>
            {{ poi.name }} ({{ poi.city.name }}) - 
            <a href="{{ path('admin_poi_edit', {'id': poi.id}) }}">Éditer</a>
        </li>
    {% endfor %}
</ul>

{# ----------------------------- #}
{# Dernières Catégories #}
{# ----------------------------- #}
<h2>Dernières Catégories</h2>
<ul>
    {% for cat in categories %}
        <li>
            {{ cat.name }} - 
            <a href="{{ path('admin_poicategory_edit', {'id': cat.id}) }}">Éditer</a>
        </li>
    {% endfor %}
</ul>

{# ----------------------------- #}
{# Derniers Utilisateurs #}
{# ----------------------------- #}
<h2>Derniers Utilisateurs</h2>
<ul>
    {% for user in users %}
        <li>
            {{ user.email }} - 
            <a href="{{ path('admin_user_edit', {'id': user.id}) }}">Éditer</a>
        </li>
    {% endfor %}
</ul>

{# ----------------------------- #}
{# Derniers Avis #}
{# ----------------------------- #}
<h2>Derniers Avis</h2>
<ul>
    {% for review in lastReviews %}
        <li>
            POI ID: {{ review.getPoiId() }}, 
            Utilisateur ID: {{ review.getUserId() }}, 
            Note: {{ review.getRating() }} - 
            "{{ review.getComment() }}" 
            <a href="{{ path('admin_review_delete', {'id': review.getId()}) }}" 
               onclick="return confirm('Voulez-vous vraiment supprimer cet avis ?')">
               Supprimer
            </a>
        </li>
    {% else %}
        <li>Aucun avis pour le moment.</li>
    {% endfor %}
</ul>

{# ----------------------------- #}
{# Lien vers la page complète des avis #}
{# ----------------------------- #}
<p style="margin-top:20px;">
    <a href="{{ path('admin_review_index') }}" class="btn btn-primary">Voir tous les avis</a>
</p>

{% endblock %}
