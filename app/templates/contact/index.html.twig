{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
<section>
    <h1>Contactez-nous</h1>

    {# Messages flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <form action="{{ path('contact_index') }}" method="post" novalidate>
        
        {# 🔐 Protection CSRF #}
        <input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">

        <div>
            <label for="name">Nom</label>
            <input 
                type="text" 
                id="name" 
                name="name" 
                required
                minlength="2"
                maxlength="100"
                pattern="[A-Za-zÀ-ÿ\s\-']+"
                title="Le nom doit contenir uniquement des lettres"
            >
        </div>

        <div>
            <label for="email">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                required
                maxlength="180"
            >
        </div>

        <div>
            <label for="message">Message</label>
            <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required
                minlength="10"
                maxlength="1000"
            ></textarea>
        </div>

        <button type="submit">Envoyer</button>
    </form>
</section>

<section>
    <h2>Notre localisation</h2>
    <div id="contactMap" style="height: 400px;"></div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // =====================
    // CARTE LEAFLET
    // =====================
    const map = L.map('contactMap').setView([{{ officeLat }}, {{ officeLng }}], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    L.marker([{{ officeLat }}, {{ officeLng }}])
        .addTo(map)
        .bindPopup('<strong>Notre bureau</strong>')
        .openPopup();
});
</script>
{% endblock %}
