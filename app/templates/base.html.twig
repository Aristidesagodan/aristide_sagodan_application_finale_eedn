<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Travel Guide{% endblock %}</title>

    <link rel="stylesheet" href="{{ asset('app.css') }}">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
</head>

<body class="light">

<header class="site-header">
    <div class="logo">
        🌍 <strong>Travel Guide</strong>
    </div>

    <button id="themeToggle">🌙 / ☀️</button>

    <nav>
        <a href="{{ path('home') }}">Accueil</a>
        <a href="{{ path('contact_index') }}">Contact</a>

        {% if app.user %}
            <span>{{ app.user.email }}</span>
            <a href="{{ path('logout') }}">Déconnexion</a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_dashboard') }}">Admin</a>
            {% endif %}
        {% else %}
            <a href="{{ path('login') }}">Connexion</a>
            <a href="{{ path('register') }}">Inscription</a>
        {% endif %}
    </nav>
</header>

<main>
    {% block body %}{% endblock %}

    {% if app.user %}
    <!-- Formulaire global d'avis -->
    <div id="reviewFormContainer" style="display:none;">
        <form id="reviewForm" method="POST" action="#">
            <h3>Laisser ou modifier un avis</h3>
            <input type="hidden" id="reviewPoiId" name="poi_id">
            
            <label for="reviewRating">Note (1-5):</label>
            <input type="number" id="reviewRating" name="rating" min="1" max="5" step="0.5" required>

            <label for="reviewComment">Commentaire :</label>
            <textarea id="reviewComment" name="comment" required></textarea>

            <button type="submit">Envoyer</button>
            <button type="button" id="cancelReview">Annuler</button>
        </form>
    </div>
    {% endif %}

    <!-- Liste des avis pour le POI sélectionné -->
    <div id="reviewsList" style="display:none;">
        <h4>Avis</h4>
        <ul id="reviewsContainer"></ul>
    </div>
</main>

<footer>
    <nav class="footer-nav">
        <a href="{{ path('about') }}">À propos & cookies</a> |
        <a href="{{ path('contact_index') }}">Contact</a> |
        <a href="{{ path('faq') }}">FAQ</a>
    </nav>
    <p>© {{ "now"|date("Y") }} Travel Guide</p>
</footer>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="{{ asset('app.js') }}" defer></script>
</body>
</html>
