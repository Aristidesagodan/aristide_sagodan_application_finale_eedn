{% extends 'base.html.twig' %}

{% block title %}Explorer{% endblock %}

{% block body %}

<!-- =========================
     SECTION RECHERCHE
========================= -->
<section class="search-section">
    <h2>Rechercher une ville</h2>

    <div class="search-box">
        <input type="text" id="cityInput" placeholder="Ex: Paris">
        <button id="searchBtn">Rechercher</button>
    </div>
</section>


<!-- =========================
     SECTION RESULTATS
========================= -->
<section id="results" class="results" style="display:none">

    <h2 id="cityTitle"></h2>

    <div class="activity-accommodation">

        <!-- ACTIVITÉS -->
        <div>
            <h3>🎯 Activités</h3>
            <ul id="activities"></ul>
        </div>

        <!-- HEBERGEMENTS -->
        <div>
            <h3>🏨 Hébergements</h3>
            <ul id="accommodations"></ul>
        </div>

    </div>

</section>


<!-- =========================
     CARTE
========================= -->
<section class="map-section">
    <h2>Carte interactive</h2>
    <div id="map"></div>
</section>


{% if app.user %}
<!-- =========================
     FORMULAIRE AVIS
========================= -->
<div id="reviewFormContainer" style="display:none;">
    <form id="reviewForm" method="POST" action="#">
        <h3>Laisser ou modifier un avis</h3>

        <input type="hidden" id="reviewPoiId" name="poi_id">

        <label for="reviewRating">Note (1-5):</label>
        <input type="number" id="reviewRating" name="rating" min="1" max="5" step="0.5" required>

        <label for="reviewComment">Commentaire :</label>
        <textarea id="reviewComment" name="comment" required></textarea>

        <button type="submit">Envoyer</button>
        <button type="button" id="cancelReview">Annuler</button>
    </form>
</div>


<!-- =========================
     LISTE AVIS
========================= -->
<div id="reviewsList" style="display:none;">
    <h4>Avis</h4>
    <ul id="reviewsContainer"></ul>
</div>
{% endif %}

{% endblock %}
